{
  "name": "app-tmp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run lint:content && npm run check:mdx && npm run check:figures && npm run test:unit",
    "lint:content": "python3 scripts/content-lint.py",
    "test:unit": "tsx --import ./scripts/_stub-server-only.cjs scripts/test-scheduler.ts && tsx --import ./scripts/_stub-server-only.cjs scripts/test-safety.ts && tsx --import ./scripts/_stub-server-only.cjs scripts/test-runner.ts && tsx --import ./scripts/_stub-server-only.cjs scripts/test-state.ts",
    "backup": "tsx --import ./scripts/_stub-server-only.cjs scripts/backup-state.ts",
    "check:links": "python3 scripts/check-links.py",
    "check:mdx": "tsx scripts/check-mdx.ts",
    "check:figures": "tsx --import ./scripts/_stub-server-only.cjs scripts/check-figures.tsx",
    "audit:sources": "tsx --import ./scripts/_stub-server-only.cjs scripts/source-audit.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.0",
    "next": "16.3.2",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
