# Foundry — rooted, so these only ever match at the project root. An unrooted pattern here
# matches at any depth: `lib/` once swallowed scripts/networks/lib/, four of our own source files.
/out/
/cache/
/broadcast/

# Dependencies
# lib/ is NOT ignored: forge-std is vendored so a fresh clone builds without `forge install`.
# The pattern was also unrooted, which silently swallowed scripts/networks/lib/ — our own source.
node_modules/

# Exercise output (measure practices write here, always at the project root)
/results/

# Environment — RPC URLs and keys never belong in the repo
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Test-runner artefacts
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# Rust / Solana / Anchor
# `target/` is Cargo's and Anchor's; Foundry's is `out/`, above. Both are rooted so a member
# crate's own target dir is caught too.
/target/
**/target/

# Anchor writes the program keypair and IDL under target/, which is already ignored. It also
# writes a node_modules for its TS tooling if you ever add TS tests.
.anchor/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
/out/results.xml

# Exercise output written at the repo root by the zkVM bench
/results.csv

# Noir. Prover.toml is NOT ignored — it is the witness, which is the exercise's input, and
# regenerating it on every clone loses whatever the learner put there.
/circuits/*/target/
