# Foundry — rooted, so these only ever match at the project root. An unrooted pattern here
# matches at any depth: `lib/` once swallowed scripts/networks/lib/, four of our own source files.
/out/
/cache/
/broadcast/

# Dependencies
# lib/ is NOT ignored: forge-std is vendored so a fresh clone builds without `forge install`.
# The pattern was also unrooted, which silently swallowed scripts/networks/lib/ — our own source.
node_modules/

# Exercise output (measure practices write here, always at the project root)
/results/

# Environment — RPC URLs and keys never belong in the repo
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Test-runner artefacts
/test-results/
/playwright-report/
/blob-report/
/.playwright/
