{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals"],

    "strict": true,
    "noImplicitOverride": true,

    // NOT noUncheckedIndexedAccess. It is a good flag in application code and the wrong one here:
    // a test that indexes a fixture array is the normal shape of an exercise, and every one of
    // them would need a non-null assertion that teaches nothing about the subject. Turning it on
    // put 11 errors into hand-authored tests that were written before this file existed.

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "drills/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "lib", "out", "cache"]
}
